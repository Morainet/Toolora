{
  "name": "@parsy/file-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Local browser parsers for Word, Excel, and PDF files.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["src"],
  "scripts": {
