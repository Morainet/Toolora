{
  "name": "@parsy/file-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Local browser parsers and viewers for Word, Excel, PDF, and XMind files.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "echo \"(file-parser) lint: no-op\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter verbose",
    "clean": "echo \"(file-parser) nothing to clean\""
  },
  "dependencies": {
    "jszip": "3.10.2",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^6.2.108",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
