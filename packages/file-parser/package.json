    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter verbose",
    "clean": "echo \"(file-parser) nothing to clean\""
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^5.4.149",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
